# Copy to .env and set your PC's LAN IP or the API server IP.
# Expo Go on a phone cannot use localhost — it must reach your API server.
#
# Reference the same API_HOST from the root .env file (default: 10.1.150.51)
# Docker backend is exposed on port 5000 by default.
EXPO_PUBLIC_API_URL=http://10.1.150.51:5000

# Or set host only (port defaults to 5000):
# EXPO_PUBLIC_API_HOST=10.1.150.51
