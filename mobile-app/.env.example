# Copy to .env and set your PC's LAN IP (find with ipconfig / ifconfig).
# Expo Go on a phone cannot use localhost — it must reach your dev machine.
#
# Docker backend is exposed on port 5000 by default.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000

# Or set host only (port defaults to 5000):
# EXPO_PUBLIC_API_HOST=192.168.1.100
