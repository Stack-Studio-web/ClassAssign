# Hallora Mobile — API configuration
#
# Production (recommended):
EXPO_PUBLIC_API_URL=https://iexam.kumaraguru.in/api
#
# IP-only fallback:
# EXPO_PUBLIC_API_URL=http://213.210.37.189:3002/api
# EXPO_PUBLIC_API_URL=http://213.210.37.189:5002/api
#
# Local dev — physical device: leave EXPO_PUBLIC_API_URL UNSET for LAN auto-detect
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:5002/api

EXPO_PUBLIC_ALLOW_HTTP=true
EXPO_PUBLIC_API_PORT=5002
