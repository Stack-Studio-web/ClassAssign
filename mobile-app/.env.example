# Hallora Mobile — development networking
#
# Physical device (Expo Go): leave EXPO_PUBLIC_API_URL UNSET for LAN auto-detect.
#
# Hostinger VPS production:
# EXPO_PUBLIC_API_URL=http://213.210.37.189:5002/api
#
# Android emulator only: EXPO_PUBLIC_API_URL=http://10.0.2.2:5002

EXPO_PUBLIC_ALLOW_HTTP=true
EXPO_PUBLIC_API_PORT=5000
