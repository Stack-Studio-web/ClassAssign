# Hallora Mobile — development networking
#
# Physical device (Expo Go): leave EXPO_PUBLIC_API_URL UNSET.
# The app auto-detects your PC's LAN IP from the Metro bundler (same IP as the QR code).
#
# Android emulator only: EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#
# Optional manual override (PC LAN IP — never use localhost on a phone):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000

EXPO_PUBLIC_ALLOW_HTTP=true
EXPO_PUBLIC_API_PORT=5000
