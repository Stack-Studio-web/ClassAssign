# Hallora Mobile environment configuration
#
# Production (required for release builds):
# EXPO_PUBLIC_API_URL=https://your-api.example.com
#
# Development (physical device on LAN):
# EXPO_PUBLIC_ALLOW_HTTP=true
# EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:5000
#
# Or host + port only:
# EXPO_PUBLIC_API_HOST=192.168.1.10
# EXPO_PUBLIC_API_PORT=5000
#
# Optional SSL pinning (comma-separated SHA-256 hashes):
# EXPO_PUBLIC_SSL_PIN_HASHES=abc123...,def456...
#
# Android release versioning (EAS auto-increments in production profile):
# ANDROID_VERSION_CODE=1

EXPO_PUBLIC_ALLOW_HTTP=true
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
