# ── Frontend Dockerfile (multi-stage) ──────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

# package.json and package-lock.json are at the root CLASSASSIGN/ level
COPY package*.json ./
RUN npm ci

# Copy all frontend source files from root
COPY index.html .
COPY vite.config.js .
COPY src/ ./src/
COPY public/ ./public/

# Build for production (VITE_API_URL baked in — default /api uses container nginx proxy)
RUN npm run build

# ── Production stage: serve with Nginx ──────────────────────────────
FROM nginx:stable-alpine
COPY --from=builder /app/dist /usr/share/nginx/html

# Custom nginx config to support React Router (SPA)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]