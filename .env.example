# Copy to project root as .env (never commit). Docker Compose reads these variables.

# ── Local development defaults ──────────────────────────────────────────────
API_HOST=localhost
API_PORT=5000
FRONTEND_PORT=5173

NODE_ENV=production
POSTGRES_USER=classassign
POSTGRES_PASSWORD=change-me-use-strong-random-password
POSTGRES_DB=classassign
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_SECONDS=86400

# ── Production (https://iexam.kumaraguru.in) ────────────────────────────────
# FRONTEND_URL=https://iexam.kumaraguru.in
# CORS_ORIGINS=https://iexam.kumaraguru.in
# API_PUBLIC_URL=https://iexam.kumaraguru.in
# USE_HTTPS=true

# Microsoft SSO (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Monitoring (optional)
SENTRY_DSN=

# Institution timezone for attendance window (IANA, e.g. Asia/Kolkata)
INSTITUTION_TIMEZONE=Asia/Kolkata
# Minutes after exam start when attendance auto-closes (default 40)
DEFAULT_ATTENDANCE_CLOSE_OFFSET_MINUTES=40

# For local dev DB access only: docker compose --profile dev up (does not expose DB by default)
