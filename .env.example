# Copy to project root as .env (never commit). Docker Compose reads these variables.

# ── Hostinger VPS (213.210.37.189) ───────────────────────────────────────────
VPS_IP=213.210.37.189
BACKEND_HOST_PORT=5002
FRONTEND_HOST_PORT=3002
API_PORT=5000

FRONTEND_URL=http://213.210.37.189:3002
CORS_ORIGINS=http://213.210.37.189:3002,http://213.210.37.189:5002
ALLOWED_ORIGINS=http://213.210.37.189:3002,http://213.210.37.189:5002
API_PUBLIC_URL=http://213.210.37.189:5002
VITE_API_URL=/api
USE_HTTPS=false

# ── Local development overrides (comment VPS block above, uncomment below) ───
# API_HOST=localhost
# BACKEND_HOST_PORT=5000
# FRONTEND_HOST_PORT=5173
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

NODE_ENV=production
POSTGRES_USER=classassign
POSTGRES_PASSWORD=change-me-use-strong-random-password
POSTGRES_DB=classassign
SESSION_TTL_SECONDS=86400

# Microsoft SSO (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Monitoring (optional)
SENTRY_DSN=

INSTITUTION_TIMEZONE=Asia/Kolkata
DEFAULT_ATTENDANCE_CLOSE_OFFSET_MINUTES=40

# ── KCT domain deployment (optional) ────────────────────────────────────────
# FRONTEND_URL=https://iexam.kumaraguru.in
# CORS_ORIGINS=https://iexam.kumaraguru.in
# ALLOWED_ORIGINS=https://iexam.kumaraguru.in
