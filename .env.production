# Hostinger VPS production — copy to .env on server (213.210.37.189)
# Usage: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

NODE_ENV=production

VPS_IP=213.210.37.189
BACKEND_HOST_PORT=5002
FRONTEND_HOST_PORT=3002

POSTGRES_USER=classassign
POSTGRES_PASSWORD=change-me-use-strong-random-password
POSTGRES_DB=classassign

# Public URLs
FRONTEND_URL=http://213.210.37.189:3002
CORS_ORIGINS=http://213.210.37.189:3002,http://213.210.37.189:5002
ALLOWED_ORIGINS=http://213.210.37.189:3002,http://213.210.37.189:5002
API_PUBLIC_URL=http://213.210.37.189:5002

# Relative /api — frontend container nginx proxies to backend (recommended)
# Or set full URL: VITE_API_URL=http://213.210.37.189:5002/api
VITE_API_URL=/api

USE_HTTPS=false
SESSION_TTL_SECONDS=86400

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

SENTRY_DSN=
INSTITUTION_TIMEZONE=Asia/Kolkata
DEFAULT_ATTENDANCE_CLOSE_OFFSET_MINUTES=40
