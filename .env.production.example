# Production environment — Hostinger VPS / iexam.kumaraguru.in
# Copy to .env on server: cp .env.production.example .env

NODE_ENV=production
PRODUCTION=true

VPS_IP=213.210.37.189
BACKEND_HOST_PORT=5002
FRONTEND_HOST_PORT=3002

POSTGRES_USER=classassign
POSTGRES_PASSWORD=change-me-use-strong-random-password
POSTGRES_DB=classassign

# Primary domain (HTTPS)
FRONTEND_URL=https://iexam.kumaraguru.in
CORS_ORIGINS=https://iexam.kumaraguru.in,http://213.210.37.189:3002,http://213.210.37.189:5002
ALLOWED_ORIGINS=https://iexam.kumaraguru.in,http://213.210.37.189:3002,http://213.210.37.189:5002
API_PUBLIC_URL=https://iexam.kumaraguru.in
USE_HTTPS=true

# Relative /api — frontend nginx proxies to backend (recommended)
VITE_API_URL=/api
# Suppress frontend console.log / console.debug in the production bundle
VITE_PRODUCTION=true
# Direct API URLs (if needed):
# VITE_API_URL=https://iexam.kumaraguru.in/api
# VITE_API_URL=http://213.210.37.189:3002/api
# VITE_API_URL=http://213.210.37.189:5002/api

SESSION_TTL_SECONDS=86400

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

SENTRY_DSN=
INSTITUTION_TIMEZONE=Asia/Kolkata
DEFAULT_ATTENDANCE_CLOSE_OFFSET_MINUTES=60

# Invigilation duty emails (Microsoft 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support.iexam@kct.ac.in
SMTP_PASS=dgxttgqzylclfmrz
MAIL_FROM=Hallora Examination Cell <support.iexam@kct.ac.in>

# Hall Teams notifications (KCT gateway — required for delivery)
KCT_TEAMS_API_URL=http://10.1.76.76:25001/send/
KCT_TEAMS_FROM_EMAIL=entry@kct.ac.in
KCT_TEAMS_API_USER=
KCT_TEAMS_API_PASSWORD=
MOCK_TEAMS_API=false
BULL_CONCURRENCY=1
BULL_MAX_RETRIES=5

