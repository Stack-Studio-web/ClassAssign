# Production environment for https://iexam.kumaraguru.in
# Copy to .env on the Ubuntu server (never commit).

NODE_ENV=production

POSTGRES_USER=classassign
POSTGRES_PASSWORD=change-me-use-strong-random-password
POSTGRES_DB=classassign

# Public URLs — required for OAuth redirects, CORS, and mobile API
FRONTEND_URL=https://iexam.kumaraguru.in
CORS_ORIGINS=https://iexam.kumaraguru.in
ALLOWED_ORIGINS=https://iexam.kumaraguru.in
API_PUBLIC_URL=https://iexam.kumaraguru.in

# Secure session cookies behind TLS (DigiCert wildcard *.kumaraguru.in)
USE_HTTPS=true
SESSION_TTL_SECONDS=86400

# Microsoft Entra ID — register redirect URI:
#   https://iexam.kumaraguru.in/api/auth/microsoft/callback
# Mobile callback (if used):
#   https://iexam.kumaraguru.in/api/auth/microsoft/mobile-callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

SENTRY_DSN=
INSTITUTION_TIMEZONE=Asia/Kolkata
DEFAULT_ATTENDANCE_CLOSE_OFFSET_MINUTES=40
